# ==========================================
# MineIQ — Environment & Credentials Config
# ==========================================

# Application Settings
APP_ENV=development
PORT=5173
API_PORT=8000

# Database Credentials (if applicable)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mineiq_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Third-Party / Cloud APIs (e.g. Mapbox, Bhuvan, Copernicus, Kaggle, HuggingFace)
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
BHUVAN_API_KEY=your_bhuvan_api_key_here
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# ML Model & Pipeline Configuration
MODEL_DIR=mlModel/models
PROSPECTIVITY_MODEL_PATH=mlModel/models/model_1_prospectivity.pkl
PRODUCTIVITY_MODEL_PATH=mlModel/models/model_2_productivity.pkl
RAW_DATA_PATH=mlModel/data/raw
PROCESSED_DATA_PATH=mlModel/data/processed

# Security Secrets (JWT / Sessions)
SECRET_KEY=your_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here
