# ==============================================================================
# AyaskVedh (SIH 2026 PS 26009) — Environment & Remote Sensing API Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & INTERNAL ENDPOINTS (Lat/Lon Query Pipelines)
# ------------------------------------------------------------------------------
APP_ENV=development
PORT=5173
API_PORT=8000
VITE_API_URL=http://127.0.0.1:8000

# Backend endpoints called upon clicking/inspecting Latitude & Longitude:
API_ENDPOINT_HEALTH=http://127.0.0.1:8000/api/health
API_ENDPOINT_MINES=http://127.0.0.1:8000/api/mines
API_ENDPOINT_EXPLORATION_POINTS=http://127.0.0.1:8000/api/exploration/points
API_ENDPOINT_EXPLORATION_FEATURES=http://127.0.0.1:8000/api/exploration/features
API_ENDPOINT_EXPLORATION_PREDICT=http://127.0.0.1:8000/api/exploration/predict
API_ENDPOINT_EXPLORATION_EXPLAIN=http://127.0.0.1:8000/api/exploration/explain
API_ENDPOINT_PRODUCTION_PREDICT=http://127.0.0.1:8000/api/production/predict
API_ENDPOINT_PRODUCTION_EXPLAIN=http://127.0.0.1:8000/api/production/explain
API_ENDPOINT_PRODUCTION_RECOMMENDATIONS=http://127.0.0.1:8000/api/production/recommendations
API_ENDPOINT_PRODUCTION_WHAT_IF=http://127.0.0.1:8000/api/production/what-if
API_ENDPOINT_MODEL_PERFORMANCE=http://127.0.0.1:8000/api/model-performance

# ------------------------------------------------------------------------------
# 2. EARTH OBSERVATION & SATELLITE MULTISPECTRAL APIS (Sentinel-2 L2A)
# Used for Bands B2-B12, NDVI, NDMI, NDWI, NDBI, SWIR Ratio, Iron Oxide & Clay Indices
# ------------------------------------------------------------------------------
# Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub API
COPERNICUS_CDSE_BASE_URL=https://sh.dataspace.copernicus.eu
COPERNICUS_CDSE_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1/Products
COPERNICUS_AUTH_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here
SENTINEL_HUB_INSTANCE_ID=your_sentinel_hub_instance_id_here

# ------------------------------------------------------------------------------
# 3. TOPOGRAPHY & DIGITAL ELEVATION MODEL (DEM) APIS (SRTM 30m / ALOS PALSAR)
# Used for Elevation, Slope, Aspect, Curvature, TPI, TRI, Roughness, Drainage Density
# ------------------------------------------------------------------------------
# OpenTopography Global High-Resolution DEM API
OPENTOPOGRAPHY_API_URL=https://portal.opentopography.org/API/globaldem
OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key_here

# Open-Elevation Global Elevation Lookup API (Free WGS84 point elevation)
OPEN_ELEVATION_API_URL=https://api.open-elevation.com/api/v1/lookup

# USGS Machine-to-Machine (M2M) API (SRTM 1 Arc-Second Global)
USGS_M2M_API_URL=https://m2m.cr.usgs.gov/api/api/json/stable/
USGS_USERNAME=your_usgs_username_here
USGS_PASSWORD=your_usgs_password_here

# ------------------------------------------------------------------------------
# 4. PEDOLOGY & GEOCHEMICAL SOIL APIS (ISRIC SoilGrids 250m)
# Used for Soil pH, Clay %, Sand %, Silt %, Bulk Density, CEC, Organic Carbon
# ------------------------------------------------------------------------------
# ISRIC SoilGrids REST API v2.0 (Point coordinate extraction)
SOILGRIDS_API_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

# ------------------------------------------------------------------------------
# 5. HYDROMETEOROLOGY & PALEOCLIMATE APIS (ERA5-Land & IMD Reanalysis)
# Used for Annual Rainfall, Mean Temperature, LST (Land Surface Temp), Soil Moisture
# ------------------------------------------------------------------------------
# Open-Meteo Historical Climate API (Free ERA5 reanalysis by coordinate)
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# ECMWF Copernicus Climate Data Store (CDS API)
ECMWF_CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
ECMWF_CDS_KEY=your_ecmwf_cds_api_key_here

# ------------------------------------------------------------------------------
# 6. GEOLOGY, LITHOLOGY & STRUCTURE (ISRO Bhuvan & GSI Bhukosh)
# Used for Mansar Host Rock, Lineaments, Faults, Structural Intersections
# ------------------------------------------------------------------------------
# ISRO Bhuvan OGC Web Map Service (WMS/WFS) for Geological & Thematic Rasters
BHUVAN_WMS_URL=https://bhuvan-vec2.nrsc.gov.in/bhuvan/wms
BHUVAN_API_KEY=your_bhuvan_api_key_here

# Geological Survey of India (GSI) Bhukosh Portal & Spatial Services
GSI_BHUKOSH_PORTAL_URL=https://bhukosh.gsi.gov.in/Bhukosh/MapViewer.aspx
GSI_WMS_ENDPOINT=https://bhukosh.gsi.gov.in/geoserver/wms

# ------------------------------------------------------------------------------
# 7. GEOPHYSICS (Bouguer Gravity Anomaly & Resistivity)
# Used for Subsurface Density Contrast & Electrical Sounding
# ------------------------------------------------------------------------------
# International Gravimetric Bureau (BGI) World Gravity Map (WGM2012)
BGI_GRAVITY_API_URL=https://bgi.omp.eu
NGRI_GRAVITY_DATA_URL=https://www.ngri.res.in

# ------------------------------------------------------------------------------
# 8. GIS BASEMAP & TILE PROVIDERS (Leaflet Map Layers)
# ------------------------------------------------------------------------------
ARCGIS_IMAGERY_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
ARCGIS_LIGHT_GRAY_TILE_URL=https://services.arcgisonline.com/arcgis/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}
ARCGIS_DARK_GRAY_TILE_URL=https://services.arcgisonline.com/arcgis/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# ------------------------------------------------------------------------------
# 9. DATABASE & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ayaskvedh_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
SECRET_KEY=your_secret_jwt_key_here
ENCRYPTION_KEY=your_encryption_key_here

# ------------------------------------------------------------------------------
# 10. ML MODEL ARTIFACT PATHS
# ------------------------------------------------------------------------------
MODEL_DIR=mlModel/models
PROSPECTIVITY_MODEL_PATH=mlModel/models/prospectivity_classifier.joblib
PRODUCTION_REGRESSOR_PATH=mlModel/models/production_regressor.joblib
SHORTFALL_CLASSIFIER_PATH=mlModel/models/shortfall_classifier.joblib
RAW_DATA_PATH=mlModel/data/raw
PROCESSED_DATA_PATH=mlModel/data/processed
